.env
.env.*

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.vercel

# Source cookbook PDFs — large + copyrighted, never commit
source-pdfs/

# Extraction scratch output (regenerable from PDFs)
# Intermediate pipeline data — regenerated from the source PDFs.
# ingredients.json is the ONE exception: it is the output of the only
# step that needs the 437MB of cookbooks, so committing it lets the four
# downstream scripts run on any clone. Derived data, not the source.
tools/extracted/*
!tools/extracted/ingredients.json

# Python bytecode from the catalog pipeline in tools/
__pycache__/
*.pyc

# Playwright
test-results/
playwright-report/
